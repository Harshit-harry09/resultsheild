# Cache
CACHE_TTL_SECONDS=172800
STAMPEDE_LOCK_TTL_SECONDS=5
STAMPEDE_WAIT_RETRY_MS=100
STAMPEDE_MAX_WAIT_MS=4500

# Queue / admission
MAX_CONCURRENT_ADMITTED=1000
RATE_LIMIT_UNAUTHENTICATED_RPM=20

# Shutdown
SHUTDOWN_GRACE_MS=10000

# Autoscaling
MIN_REPLICAS=1
MAX_REPLICAS=16
TARGET_IN_FLIGHT_PER_REPLICA=100
AUTOSCALER_POLL_INTERVAL_SECONDS=5
SCALE_UP_THRESHOLD=0.70
SCALE_DOWN_THRESHOLD=0.30

# Frontend
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_POLL_JITTER_MS=1500

# Academic
PASS_THRESHOLD_PERCENTAGE=33

# Data
SEED_RECORD_COUNT=50000

# Database
DATABASE_URL=postgres://app:app@pgbouncer:5432/results
REDIS_URL=redis://redis:6379

# Postgres (used by docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=results

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
