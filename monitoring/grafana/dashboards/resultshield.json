{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "ResultShield — Load-Resilient Exam Portal. Shows request rate, latency, error rate, cache performance, replica count, queue depth, and CPU/memory.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[30s]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "title": "Requests per Second",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#1B2A4A", "value": null },
              { "color": "#C9822B", "value": 0.5 },
              { "color": "#8B2635", "value": 1.0 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "title": "Latency P50 / P95 / P99",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#8B2635", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#2F6845", "value": null },
              { "color": "#C9822B", "value": 0.01 },
              { "color": "#8B2635", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[30s])) / sum(rate(http_requests_total[30s]))",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "title": "Error Rate (5xx)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(cache_hit_total[30s])) / (sum(rate(cache_hit_total[30s])) + sum(rate(cache_miss_total[30s])))",
          "legendFormat": "Cache Hit Rate",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#C9822B", "mode": "fixed" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(stampede_lock_wait_total[30s]))",
          "legendFormat": "Stampede Lock Waits/sec",
          "refId": "A"
        }
      ],
      "title": "Stampede Lock Contention",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#1B2A4A", "mode": "fixed" },
          "custom": { "lineWidth": 3 },
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#1B2A4A", "value": null },
              { "color": "#C9822B", "value": 3 },
              { "color": "#8B2635", "value": 7 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "count(up{job=\"resultshield-backend\"} == 1)",
          "legendFormat": "Replicas",
          "refId": "A"
        }
      ],
      "title": "Backend Replica Count",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#2F6845", "value": null },
              { "color": "#C9822B", "value": 50 },
              { "color": "#8B2635", "value": 150 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "id": 7,
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "max(queue_depth)",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ],
      "title": "Virtual Queue Depth",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#2F6845", "value": null },
              { "color": "#C9822B", "value": 50 },
              { "color": "#8B2635", "value": 180 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 16 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(http_requests_in_flight)",
          "legendFormat": "In-flight Requests",
          "refId": "A"
        }
      ],
      "title": "In-Flight Requests (autoscaler signal)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1.5 },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#1B2A4A", "value": null },
              { "color": "#C9822B", "value": 0.50 },
              { "color": "#8B2635", "value": 0.80 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 9,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"resultshield.*\"}[30s])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Container CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1.5 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 10,
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{name=~\"resultshield.*\"}) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Container Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(cache_hit_total[30s]))",
          "legendFormat": "Cache Hits/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cache_miss_total[30s]))",
          "legendFormat": "Cache Misses/sec",
          "refId": "B"
        },
        {
          "expr": "sum(rate(queue_admitted_total[30s]))",
          "legendFormat": "Queue Admissions/sec",
          "refId": "C"
        }
      ],
      "title": "Cache & Queue Activity",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["resultshield"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ResultShield — Load Resilience Dashboard",
  "uid": "resultshield-main",
  "version": 1
}
